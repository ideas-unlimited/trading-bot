//@version=5
// Port of src/bot/strategy/sma_cross.py — long when the fast SMA is above the
// slow SMA, flat otherwise, with an ATR stop sized from risk-per-trade.
// Orders fill at the NEXT bar's open (Pine's default), matching the engine
// in src/bot/backtest.py, so Strategy Tester results should track the
// Python backtest closely.
strategy("SMA Cross (bot port)", overlay=true, initial_capital=10000,
     default_qty_type=strategy.fixed,
     commission_type=strategy.commission.percent, commission_value=0.1,
     slippage=5)

// ---- inputs (defaults match the Python strategy) --------------------------
fastLen  = input.int(20, "Fast SMA length", minval=1)
slowLen  = input.int(50, "Slow SMA length", minval=2)
atrMult  = input.float(2.5, "ATR stop multiple", minval=0.1, step=0.1)
riskPct  = input.float(1.0, "Risk per trade (% equity)", minval=0.01, step=0.1)
maxPosPct = input.float(95.0, "Max position (% equity)", minval=1, maxval=100)
alertToken = input.string("", "Alert secret token (mirrors alerts to your bot)")

// ---- indicators -----------------------------------------------------------
fastSma = ta.sma(close, fastLen)
slowSma = ta.sma(close, slowLen)
atr     = ta.atr(14)

crossUp = ta.crossover(fastSma, slowSma)
crossDn = ta.crossunder(fastSma, slowSma)

// ---- risk sizing (mirrors risk.RiskManager.size) --------------------------
var float stopPrice = na
stopDist = atrMult * atr
riskQty  = strategy.equity * riskPct / 100 / stopDist          // risk between entry and stop
capQty   = strategy.equity * maxPosPct / 100 / close           // never allocate more than maxPosPct
qty      = math.min(riskQty, capQty)

// ---- alert payload for the bot's webhook (see src/bot/alerts.py) ----------
payload(action, px, stop) =>
    '{"action":"' + action + '","symbol":"' + syminfo.ticker + '","price":' +
      str.tostring(px, format.mintick) + ',"stop":' +
      str.tostring(stop, format.mintick) + ',"secret":"' + alertToken + '"}'

// ---- trading --------------------------------------------------------------
if crossUp and strategy.position_size == 0 and not na(atr) and qty > 0
    stopPrice := close - stopDist
    strategy.entry("L", strategy.long, qty=qty, alert_message=payload("buy", close, stopPrice))
    strategy.exit("L-stop", "L", stop=stopPrice, alert_message=payload("close", stopPrice, stopPrice))

if crossDn and strategy.position_size > 0
    strategy.close("L", alert_message=payload("close", close, stopPrice))

plot(fastSma, "Fast SMA", color=color.new(color.teal, 0))
plot(slowSma, "Slow SMA", color=color.new(color.orange, 0))
plot(strategy.position_size > 0 ? stopPrice : na, "Stop", color=color.red, style=plot.style_linebr)
