//@version=5
// Port of src/bot/strategy/rsi_meanrev.py — enter when RSI drops below the
// entry level while price is above the trend SMA, exit when RSI recovers,
// with an ATR stop. Fills on the next bar's open, like the Python engine.
strategy("RSI Mean Reversion (bot port)", overlay=true, initial_capital=10000,
     default_qty_type=strategy.fixed,
     commission_type=strategy.commission.percent, commission_value=0.1,
     slippage=5)

// ---- inputs (defaults match the Python strategy) --------------------------
rsiLen    = input.int(14, "RSI length", minval=2)
entryLvl  = input.float(30.0, "RSI entry level", minval=1, maxval=99)
exitLvl   = input.float(55.0, "RSI exit level", minval=2, maxval=100)
trendLen  = input.int(200, "Trend SMA length", minval=2)
atrMult   = input.float(2.0, "ATR stop multiple", minval=0.1, step=0.1)
riskPct   = input.float(1.0, "Risk per trade (% equity)", minval=0.01, step=0.1)
maxPosPct = input.float(95.0, "Max position (% equity)", minval=1, maxval=100)
alertToken = input.string("", "Alert secret token (mirrors alerts to your bot)")

// ---- indicators -----------------------------------------------------------
rsi      = ta.rsi(close, rsiLen)
trendSma = ta.sma(close, trendLen)
atr      = ta.atr(14)

flipped    = rsi[1] >= entryLvl and rsi < entryLvl   // RSI just crossed below entry
inUptrend  = close > trendSma
exitSignal = rsi > exitLvl

// ---- risk sizing (mirrors risk.RiskManager.size) --------------------------
var float stopPrice = na
stopDist = atrMult * atr
riskQty  = strategy.equity * riskPct / 100 / stopDist
capQty   = strategy.equity * maxPosPct / 100 / close
qty      = math.min(riskQty, capQty)

// ---- alert payload for the bot's webhook (see src/bot/alerts.py) ----------
payload(action, px, stop) =>
    '{"action":"' + action + '","symbol":"' + syminfo.ticker + '","price":' +
      str.tostring(px, format.mintick) + ',"stop":' +
      str.tostring(stop, format.mintick) + ',"secret":"' + alertToken + '"}'

// ---- trading --------------------------------------------------------------
if flipped and inUptrend and strategy.position_size == 0 and not na(atr) and qty > 0
    stopPrice := close - stopDist
    strategy.entry("L", strategy.long, qty=qty, alert_message=payload("buy", close, stopPrice))
    strategy.exit("L-stop", "L", stop=stopPrice, alert_message=payload("close", stopPrice, stopPrice))

if exitSignal and strategy.position_size > 0
    strategy.close("L", alert_message=payload("close", close, stopPrice))

plot(trendSma, "Trend SMA", color=color.new(color.gray, 0))
plot(strategy.position_size > 0 ? stopPrice : na, "Stop", color=color.red, style=plot.style_linebr)
