[Unit]
Description=Trading bot web terminal (LIVE - real money, venue not configured)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=trader
Group=trader
WorkingDirectory=/opt/trading-bot
Environment=PYTHONUNBUFFERED=1
Environment=BOT_ENV=live
Environment=OMP_NUM_THREADS=1
Environment=OPENBLAS_NUM_THREADS=1
Environment=MALLOC_ARENA_MAX=2
ExecStart=/opt/trading-bot/.venv/bin/bot web --host 127.0.0.1 --port 9001
Restart=always
RestartSec=10
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/tradingbot /opt/trading-bot/runs /opt/trading-bot/logs
StateDirectory=tradingbot/live
LogsDirectory=tradingbot/live
# Same caps as demo: one process, one bars frame per request.
MemoryHigh=512M
MemoryMax=1G
MemorySwapMax=0

[Install]
WantedBy=multi-user.target
