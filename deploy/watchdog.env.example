# /etc/tradingbot/watchdog.env -- root:trader 0640
#
# Read by tradingbot-watchdog.service.  The watchdog names a dead loop from
# the per-bot heartbeats and pings the dead-man URL below only while every
# running bot is fresh.  Deployment state, never committed.

# Dead-man ping (healthchecks.io, Uptime Kuma, ...).  Empty = off.
# ONE url for the whole book is correct here: a ping means the watchdog ran
# and found no stale bot, so green is every loop beating.  Never give the
# individual bots a shared URL - any survivor would keep it green.
HEARTBEAT_URL=

# Silence before a bot is called stale, and how often to repeat the alert
# about the same dead bot.  The timer runs every 5 minutes.
WATCHDOG_STALE_MINUTES=10
WATCHDOG_REPEAT_HOURS=6
