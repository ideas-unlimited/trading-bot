# /etc/tradingbot/forward.env -- root:trader 0640
#
# Read by systemd for tradingbot-forward.service.  This file is deployment
# state, not code: it can carry secrets and must never be committed.

BOT_ENV=paper

# Dead-man ping (healthchecks.io, Uptime Kuma, ...).  Empty = off.
HEARTBEAT_URL=

# Trade alerts are for live bots only: /etc/tradingbot/alerts.env.  This
# forward replay unit is silent; `bot forward --alerts` opts in manually.
