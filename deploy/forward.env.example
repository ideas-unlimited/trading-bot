# /etc/tradingbot/dryrun.env -- root:trader 0640
#
# Read by systemd for tradingbot-dryrun.service.  This file is deployment
# state, not code: it can carry secrets and must never be committed.

BOT_ENV=demo

# Process check for this runner (healthchecks.io, Uptime Kuma, ...).
# Empty = off.  One process replays every sleeve, so one URL is right here;
# the per-bot book check lives in watchdog.env and must be a different check.
HEARTBEAT_URL=

# Trade alerts are for trading bots only: /etc/tradingbot/alerts.env.  This
# dry-run replay unit is silent; `bot dryrun --alerts` opts in manually.
