[Unit]
Description=Trading bot %i (paper)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=trader
Group=trader
WorkingDirectory=/opt/trading-bot
Environment=PYTHONUNBUFFERED=1
# One bot measures ~90 MB.  Single-threaded BLAS keeps numpy from allocating a
# buffer pool per core, and the 2-arena malloc cap stops glibc reserving a
# 64 MB arena per thread.  MemoryHigh throttles a slow leak; MemoryMax kills
# and restarts one bot instead of letting it take the box down.
Environment=OMP_NUM_THREADS=1
Environment=OPENBLAS_NUM_THREADS=1
Environment=MALLOC_ARENA_MAX=2
# Alert channels are shared with the forward runner and every other bot.
EnvironmentFile=-/etc/tradingbot/alerts.env
ExecStart=/opt/trading-bot/deploy/run_bot.sh %i
# Durable bot log: journald stays the live tail, this file is the archive
# (rotated by /etc/logrotate.d/tradingbot).  LOG_DIR is derived from BOT_ENV
# by run_bot.sh, so paper and prod bots land in their own folder.
StandardOutput=append:${LOG_DIR}/%i.log
StandardError=inherit
Restart=always
RestartSec=15
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/tradingbot /var/log/tradingbot
MemoryHigh=384M
MemoryMax=768M
MemorySwapMax=0
TasksMax=64

[Install]
WantedBy=multi-user.target
