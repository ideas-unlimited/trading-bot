# /etc/tradingbot/alerts.env -- root:trader 0640
#
# Channel configuration for every live tradingbot@<name>.service.  The
# forward replay is deliberately silent.  Configure any subset; each fill
# goes to every complete channel.  One value per line, no quotes needed.
# These are secrets: keep this file out of git and record new values in
# the master secrets file outside the repo.

# Telegram (mobile push, recommended).  Create a bot with @BotFather,
# send it a message, then copy chat.id from
# https://api.telegram.org/bot<token>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ntfy (mobile push, no account).  Install the ntfy app and pick a long
# random topic; anyone with the URL can read it, so treat it as a secret.
NTFY_URL=
NTFY_TOKEN=

# Email (SMTP).  587 STARTTLS is the default; use 465 with
# SMTP_SECURITY=ssl, or none for a local relay.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_EMAIL_TO=
