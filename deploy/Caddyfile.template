# Rendered by deploy/public_web.sh into /etc/caddy/Caddyfile.
# Two hostnames so the world is unmistakable:
#   {{DEMO_DOMAIN}} -> 127.0.0.1:9000  (demo: simulated fills)
#   {{LIVE_DOMAIN}} -> 127.0.0.1:9001  (live: real money, venue not configured)
# The bare hostname redirects to demo, so old bookmarks cannot be ambiguous.
# {{USER}} / {{HASH}} are the basic-auth login and its bcrypt hash.

{{DEMO_DOMAIN}} {
	basic_auth {
		{{USER}} {{HASH}}
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}
	reverse_proxy 127.0.0.1:9000
	log {
		output file /var/log/caddy/demo.log {
			roll_size 5MB
			roll_keep 5
		}
	}
}

{{LIVE_DOMAIN}} {
	basic_auth {
		{{USER}} {{HASH}}
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}
	reverse_proxy 127.0.0.1:9001
	log {
		output file /var/log/caddy/live.log {
			roll_size 5MB
			roll_keep 5
		}
	}
}

{{LEGACY_DOMAIN}} {
	redir https://{{DEMO_DOMAIN}}{uri} 302
}
